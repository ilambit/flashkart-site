# Firebase Configuration
# Replace these with your project's Firebase configuration
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyC4X81-HpgrbDOBq9Mn7CcHctxK8d5AoH0
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=makkalstarmart.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=makkalstarmart
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=makkalstarmart.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=947085968127
NEXT_PUBLIC_FIREBASE_APP_ID=1:947085968127:web:4b630776b031f8003f02ca
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-DKCP5RJB2B

# Firebase/FCM VAPID Key
# Used for identified push notifications
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BClVPdWMylWlBalEhzUZHN_HbBc_yU4mcKBjbMWHn4lNhTlRuyXqRPyGAdg7hL3fT-hNBT8rYFhAPg_BE7wBCOU

# Google Analytics 4. Same GA4 property as the Firebase measurement ID above,
# but kept separate: this drives gtag.js directly, not Firebase.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-DKCP5RJB2B

# Demo login credentials
# demo_mode now comes from the settings API response, not this env var.
NEXT_PUBLIC_DEMO_LOGIN_NO=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_DEMO_OTP=xxxxxx

NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=in
NEXT_PUBLIC_COUNTRY_DIAL_CODE=+91

# Keep this true. false switches next.config.mjs to output:"export", which drops
# src/middleware.js — zone URLs (/bhuj-quick/...) and language URLs (/ur/...)
# then 404. The build still succeeds, so the breakage is silent. See docs/OVERVIEW.md.
NEXT_PUBLIC_SEO=true

# SEO metadata
NEXT_PUBLIC_META_TITLE="Makkal Star Mart | Online Grocery Store | Fresh Produce and More"
NEXT_PUBLIC_META_DESCRIPTION="Shop for fresh groceries online at Makkal Star Mart. We offer a wide selection of high-quality produce, meat, dairy, and pantry staples, all delivered straight to your door."
NEXT_PUBLIC_META_KEYWORDS="grocery, supermarket, online, price, store, online groceries, online grocery delivery"
