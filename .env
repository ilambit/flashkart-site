NEXT_PUBLIC_COUNTRY_DROPDOWN=false

# Google Maps JavaScript API key
NEXT_PUBLIC_MAP_API=AIzaSyCg11UGDLLTFTpXCwUfey_C7TOoiNL43mw

NEXT_PUBLIC_WEB_NAME=Makkal Star Mart

# Websocket url for chat module
NEXT_PUBLIC_WS_URL=wss://ws-ap2.pusher.com/app/fe9b1834a5ffa80c32de

# Public site URL, used for canonical URLs and SEO metadata
